# Citation testing — API keys for automated AEO measurement
# Copy this file to .env and fill in real values. .env is gitignored.

PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override the model used per engine
# PERPLEXITY_MODEL=sonar
# ANTHROPIC_MODEL=claude-opus-4-7
# OPENAI_MODEL=gpt-4o

# --- Rewrite queue (auto-rewrite pipeline for stale articles) ---
# Local Ollama for the first-pass draft. /api/generate is preferred over
# /api/chat (some models return 503 on chat).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REWRITE_MODEL=qwen3-coder:30b
# Claude polish-pass model. Override only when migrating model versions.
# CLAUDE_REWRITE_MODEL=claude-sonnet-4-6

# Where rewrite drafts land before Substack sync. Defaults (in code) to the path
# below; leave unset to inherit it. Override only if the drafts root moves again.
# ASTGL_DRAFTS_DIR="/Volumes/Research/Publishing/ASTGL/Articles/Drafts"

# Telegram approval ping. Single chat (forum-topic threadId optional).
# Reuse the bot token used by claudeclaw — same allowlisted chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_THREAD_ID=

# --- Wiki sync (SecondBrain concepts/entities/syntheses → knowledge.db) ---
# Path to the Obsidian wiki dir on the Research volume. Job skips cleanly
# (exit 0, skipped:true) if the volume is unmounted.
WIKI_ROOT=/Volumes/Research/Brain/SecondBrain/wiki
# Ollama endpoint + embedding model for chunk embeddings (768-dim).
# NOTE: sync-wiki reads OLLAMA_URL (not OLLAMA_BASE_URL used by the rewriter).
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# Analytics/rate-limit database location (data/query-log.db by default).
# Test-only seam: lets the durability suite point at a throwaway file instead of
# writing probe rows into the real analytics database. Leave unset in production —
# it moves the query log AND rate limiting together, since they share one file.
ASTGL_QUERY_LOG_DB=
