{
  "name": "mcp-astgl-knowledge",
  "mcpName": "io.github.Jmeg8r/astgl-knowledge",
  "version": "1.3.0",
  "description": "MCP server with 17 tools for searching, citing, exporting, and planning ASTGL content about MCP servers, local AI, and AI automation — includes tutorials, comparisons, idea journal, markdown export, dashboard analytics, and rate-limited API access",
  "type": "module",
  "bin": {
    "mcp-astgl-knowledge": "dist/index.js"
  },
  "files": [
    "dist",
    "build/knowledge-public.db",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "ingest": "tsx src/ingest.ts",
    "ingest-projects": "tsx src/ingest-projects.ts",
    "ingest-drafts": "tsx src/ingest-drafts.ts",
    "reconcile-drafts": "tsx src/reconcile-drafts.ts",
    "discover": "tsx src/discover.ts",
    "structure": "tsx src/structure.ts",
    "pipeline": "tsx src/pipeline.ts",
    "citation-test": "tsx src/citation-test.ts",
    "citation-test-auto": "pass-cli run --env-file .env -- tsx src/citation-test-auto.ts",
    "daily-report": "tsx src/daily-report.ts",
    "alerts": "tsx src/alerts.ts",
    "freshness": "tsx src/freshness.ts",
    "publish-drift": "tsx src/freshness.ts --only publish_gap",
    "rewrite-queue": "pass-cli run --env-file .env -- node dist/rewrite-queue.js",
    "rewrite-queue:dev": "pass-cli run --env-file .env -- tsx src/rewrite-queue.ts",
    "publish-rewrite": "pass-cli run --env-file .env -- node dist/publish-rewrite.js",
    "sync-wiki": "tsx src/sync-wiki.ts",
    "reclassify-wiki": "tsx src/sync-wiki.ts --reclassify",
    "build-public-db": "tsx src/build-public-db.ts",
    "related": "tsx src/related-articles.ts",
    "dashboard-data": "tsx src/dashboard.ts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "prepack": "npm run build && npm run reclassify-wiki && npm run build-public-db",
    "build-mcpb": "tsx src/build-mcpb.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jmeg8r/mcp-astgl-knowledge.git"
  },
  "homepage": "https://astgl.ai",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai",
    "local-ai",
    "knowledge-base",
    "astgl"
  ],
  "author": "James Cruce",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.9.1",
    "dotenv": "^17.4.2",
    "rss-parser": "^3.13.0",
    "sqlite-vec": "^0.1.6",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
